{
  "name": "ai-support-platform",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -n api,worker,web -c cyan,yellow,magenta \"pnpm dev:api\" \"pnpm dev:worker\" \"pnpm dev:web\"",
    "dev:web": "dotenv -e .env -- pnpm --filter @app/web dev",
    "dev:api": "dotenv -e .env -- pnpm --filter @app/api dev",
    "dev:worker": "dotenv -e .env -- pnpm --filter @app/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "dotenv -e .env -- pnpm --filter @app/database generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @app/database migrate",
    "db:studio": "dotenv -e .env -- pnpm --filter @app/database studio",
    "docker:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infrastructure/docker/docker-compose.yml down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.4",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0"
  }
}
